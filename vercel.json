{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/simulate-day",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/reset-daily",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cleanup-expired-payments",
      "schedule": "0 18 * * *"
    }
  ]
}
